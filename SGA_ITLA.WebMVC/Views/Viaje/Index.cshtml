@model IEnumerable<SGA_ITLA.Domain.Entities.Transporte.Viaje>
@{
    ViewData["Title"] = "Gestión Operativa de Viajes";
}

<div class="container">
    <div class="enterprise-wrap">
        <div class="corp-header">
            <div>
                <h3 class="corp-title">Planificación de Viajes</h3>
                <p class="corp-subtitle">Monitoreo de estado y asignación de recursos logísticos</p>
            </div>
            <div>
                @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                {
                    <a asp-action="Create" class="btn-primary-corp">
                        <i class="bi bi-calendar-plus-fill me-1"></i> Planificar Nuevo Viaje
                    </a>
                }
            </div>
        </div>

        <div class="table-container">
            <table class="corp-table">
                <thead>
                    <tr>
                        <th>Ruta</th>
                        <th>Horario</th>
                        <th>Autobús</th>
                        <th>Conductor</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Control</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-weight: 600; color: #1f2937;">
                                    <i class="bi bi-signpost-split text-primary me-2"></i>
                                    @(item.Ruta != null ? item.Ruta.NombreRuta : "Ruta #" + item.RutaId)
                                </td>

                                <td style="font-weight: 500; color: #374151;">
                                    <i class="bi bi-clock text-secondary me-1"></i>
                                    @item.HorarioSalidaPlanificada.ToString("hh:mm tt")
                                </td>

                                <td style="font-weight: 500; color: #374151;">
                                    <i class="bi bi-bus-front me-1 text-secondary"></i>
                                    @(item.Autobus != null ? item.Autobus.Placa : "Bus #" + item.AutobusId)
                                </td>

                                <td style="font-weight: 500; color: #374151;">
                                    <i class="bi bi-person-badge me-1 text-secondary"></i>
                                    @(item.Conductor != null ? item.Conductor.NombreCompleto : "Chofer #" + item.ConductorId)
                                </td>

                                <td>
                                    @if (item.Estado == SGA_ITLA.Domain.Enums.EstadoViaje.Programado)
                                    {
                                        <span class="status-badge" style="background-color: #e0f2fe; color: #0369a1;">
                                            <i class="bi bi-calendar-check me-1"></i> @item.Estado
                                        </span>
                                    }
                                    else if (item.Estado == SGA_ITLA.Domain.Enums.EstadoViaje.EnCurso)
                                    {
                                        <span class="status-badge" style="background-color: #fef08a; color: #854d0e;">
                                            <i class="bi bi-play-circle-fill me-1"></i> @item.Estado
                                        </span>
                                    }
                                    else if (item.Estado == SGA_ITLA.Domain.Enums.EstadoViaje.Completado)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check2-all me-1"></i> @item.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-suspended">
                                            <i class="bi bi-x-circle-fill me-1"></i> @item.Estado
                                        </span>
                                    }
                                </td>

                                <td style="text-align: right;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-link">
                                        <i class="bi bi-eye"></i> Detalles
                                    </a>

                                    @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador") || User.IsInRole("Conductor"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-link">
                                            <i class="bi bi-pencil-square"></i> Estado
                                        </a>
                                    }
                                    @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-link action-link-danger">
                                            <i class="bi bi-trash3-fill"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 4rem; color: #6b7280;">
                                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                                No hay viajes programados actualmente.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>