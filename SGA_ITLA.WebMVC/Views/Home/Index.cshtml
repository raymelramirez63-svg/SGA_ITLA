@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">SGA-ITLA</h1>
        <p class="lead text-muted">Sistema de Gestión de Autobuses y Control de Acceso</p>
    </div>

    <!-- Panel de Reportes Rápidos -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <a asp-controller="Autobus" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 bg-primary text-white h-100 rounded-4">
                    <h2 class="fw-bold display-4">🚌</h2>
                    <h5 class="fw-semibold mt-2">Control de Flota</h5>
                    <p class="small mb-0">Gestión de unidades y mantenimiento</p>
                </div>
            </a>
        </div>
        
        <div class="col-md-3">
            <a asp-controller="Viaje" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 bg-success text-white h-100 rounded-4">
                    <h2 class="fw-bold display-4">🛣️</h2>
                    <h5 class="fw-semibold mt-2">Logística de Rutas</h5>
                    <p class="small mb-0">Planificación y asignación de viajes</p>
                </div>
            </a>
        </div>
        
        <div class="col-md-3">
            <a asp-controller="Autorizacion" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 bg-warning text-dark h-100 rounded-4">
                    <h2 class="fw-bold display-4">💳</h2>
                    <h5 class="fw-semibold mt-2">Pases y Accesos</h5>
                    <p class="small mb-0">Tickets, recargas y validaciones</p>
                </div>
            </a>
        </div>
        
        <div class="col-md-3">
            <a asp-controller="Auditoria" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 bg-dark text-white h-100 rounded-4">
                    <h2 class="fw-bold display-4">📋</h2>
                    <h5 class="fw-semibold mt-2">Auditoría Institucional</h5>
                    <p class="small mb-0">Trazabilidad de operaciones (RN-AUD)</p>
                </div>
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4 bg-light">
        <h4 class="text-success fw-bold">✔️ Sistema Operativo y Conectado</h4>
        <p class="mb-0 text-muted">
            La conexión con la API de transporte está en línea. Las políticas de acceso concurrente y el registro inmutable de auditoría se encuentran activos protegiendo la integridad de las transacciones.
        </p>
    </div>
</div>