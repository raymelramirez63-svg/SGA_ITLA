@{
    ViewData["Title"] = "Panel de Control";
}

<style>
    .dash-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background-color: #ffffff;
    }

        .dash-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
            border-color: #d1d5db;
        }

    .card-icon-wrapper {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        margin-bottom: 1rem;
    }
</style>

<div class="container mt-4">
    <div class="enterprise-wrap" style="padding-top: 3rem; padding-bottom: 4rem;">

        <div class="text-center mb-5">
            <h1 class="corp-title" style="font-size: 2.2rem; color: #111827;">SGA-ITLA</h1>
            <p class="corp-subtitle" style="font-size: 1.1rem;">Sistema de Gestión de Autobuses y Control de Acceso</p>
        </div>

        <div class="row g-4 mb-5 justify-content-center">

            <!-- Control de Flota -->
            @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador") || User.IsInRole("Auditor"))
            {
                <div class="col-md-4 col-lg-3">
                    <a asp-controller="Autobus" asp-action="Index" class="text-decoration-none">
                        <div class="card dash-card h-100 p-4 text-center">
                            <div class="card-icon-wrapper mx-auto" style="background-color: #e0f2fe; color: #0284c7;">
                                <i class="bi bi-bus-front fs-4"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Control de Flota</h5>
                            <p class="small text-muted mb-0">Gestión de unidades y mantenimiento</p>
                        </div>
                    </a>
                </div>
            }

            <!-- Logística de Rutas -->
            @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador") || User.IsInRole("Auditor"))
            {
                <div class="col-md-4 col-lg-3">
                    <a asp-controller="Viaje" asp-action="Index" class="text-decoration-none">
                        <div class="card dash-card h-100 p-4 text-center">
                            <div class="card-icon-wrapper mx-auto" style="background-color: #dcfce7; color: #16a34a;">
                                <i class="bi bi-signpost-split fs-4"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Logística de Rutas</h5>
                            <p class="small text-muted mb-0">Planificación y asignación de viajes</p>
                        </div>
                    </a>
                </div>
            }

            <!--  Pases y Accesos (SOLO FINANZAS Y AUDITORÍA) -->
            @if (User.IsInRole("AdminAutorizaciones") || User.IsInRole("Administrador") || User.IsInRole("Auditor"))
            {
                <div class="col-md-4 col-lg-3">
                    <a asp-controller="Autorizacion" asp-action="Index" class="text-decoration-none">
                        <div class="card dash-card h-100 p-4 text-center">
                            <div class="card-icon-wrapper mx-auto" style="background-color: #fef9c3; color: #ca8a04;">
                                <i class="bi bi-credit-card fs-4"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Pases y Accesos</h5>
                            <p class="small text-muted mb-0">Tickets, recargas y validaciones</p>
                        </div>
                    </a>
                </div>
            }

            <!--  Gestión de Usuarios (SOLO TRANSPORTE Y ADMIN) -->
            @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
            {
                <div class="col-md-4 col-lg-3">
                    <a asp-controller="Usuario" asp-action="Index" class="text-decoration-none">
                        <div class="card dash-card h-100 p-4 text-center">
                            <div class="card-icon-wrapper mx-auto" style="background-color: #f3e8ff; color: #9333ea;">
                                <i class="bi bi-people-fill fs-4"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Gestión de Usuarios</h5>
                            <p class="small text-muted mb-0">Administración de cuentas y roles</p>
                        </div>
                    </a>
                </div>
            }

            <!--  Mis Solicitudes (EXCLUSIVO ESTUDIANTES) -->
            @if (User.IsInRole("Estudiante"))
            {
                <div class="col-md-4 col-lg-3">
                    <a asp-controller="Solicitud" asp-action="Index" class="text-decoration-none">
                        <div class="card dash-card h-100 p-4 text-center">
                            <div class="card-icon-wrapper mx-auto" style="background-color: #e0f2fe; color: #0284c7;">
                                <i class="bi bi-ticket-perforated fs-4"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Mis Solicitudes</h5>
                            <p class="small text-muted mb-0">Pide o renueva tu pase de transporte</p>
                        </div>
                    </a>
                </div>
            }

            <!-- Auditoría Institucional -->
            @if (User.IsInRole("AdminTransporte") || User.IsInRole("Auditor") || User.IsInRole("Administrador"))
            {
                <div class="col-md-4 col-lg-3">
                    <a asp-controller="Auditoria" asp-action="Index" class="text-decoration-none">
                        <div class="card dash-card h-100 p-4 text-center">
                            <div class="card-icon-wrapper mx-auto" style="background-color: #f1f5f9; color: #475569;">
                                <i class="bi bi-clipboard2-data fs-4"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Auditoría Institucional</h5>
                            <p class="small text-muted mb-0">Trazabilidad de operaciones (RN-AUD)</p>
                        </div>
                    </a>
                </div>
            }
        </div>

        <div class="card dash-card p-4 mx-auto" style="max-width: 800px; border-left: 4px solid #10b981;">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                <div>
                    <h6 class="text-dark fw-bold mb-1">Sistema Operativo y Conectado</h6>
                    <p class="mb-0 text-muted small">
                        La conexión con la API de transporte está en línea. Las políticas de acceso concurrente y el registro inmutable de auditoría se encuentran activos protegiendo la integridad de las transacciones.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>