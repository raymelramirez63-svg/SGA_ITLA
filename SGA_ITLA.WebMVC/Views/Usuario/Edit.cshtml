@model SGA_ITLA.Domain.Entities.Usuarios.Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-5">
    <h3 class="text-warning fw-bold">Ajustar Cuenta</h3>
    <hr />
    <div class="card shadow-sm p-4 border-0" style="max-width: 500px;">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="IdentificacionInstitucional" class="form-label fw-bold">Identificación Institucional</label>
                <input asp-for="IdentificacionInstitucional" class="form-control" required />
                <span asp-validation-for="IdentificacionInstitucional" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label fw-bold">Nombre Completo</label>
                <input asp-for="NombreCompleto" class="form-control" required />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">Correo Institucional</label>
                <input asp-for="Email" type="email" class="form-control" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PasswordHash" class="form-label fw-bold">Nueva Contraseña (Opcional)</label>
                <input asp-for="PasswordHash" type="password" class="form-control" value="" placeholder="Dejar en blanco para no cambiar" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Rol" class="form-label fw-bold">Rol en el Sistema</label>
                <select asp-for="Rol" class="form-select">
                    <option value="Estudiante">Estudiante</option>
                    <option value="Empleado">Empleado</option>
                    <option value="Conductor">Conductor</option>
                    <option value="AdminTransporte">Admin de Transporte</option>
                    <option value="AdminAutorizaciones">Admin de Autorizaciones</option>
                    <option value="Auditor">Auditor Institucional</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning w-100 fw-bold">Actualizar Cuenta</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
        </form>
    </div>
</div>