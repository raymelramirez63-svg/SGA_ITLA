@model IEnumerable<SGA_ITLA.Domain.Entities.Usuarios.Usuario>
@{
    ViewData["Title"] = "Directorio de Usuarios";
}
<div class="container">
    <div class="enterprise-wrap">
        <div class="corp-header">
            <div>
                <h3 class="corp-title">Directorio Institucional</h3>
                <p class="corp-subtitle">Gestión de Usuarios y Roles</p>
            </div>
            <div>
                <a asp-action="Create" class="btn-primary-corp"><i class="bi bi-person-plus-fill me-1"></i> Registrar Cuenta</a>
            </div>
        </div>
        <div class="table-container">
            <table class="corp-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th>Correo Institucional</th>
                        <th>Rol Asignado</th>
                        <th style="text-align: right;">Gestión</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-weight: 600; color: #6b7280;">#@item.Id</td>
                                <td style="font-weight: 600; color: #1f2937;"><i class="bi bi-person-circle me-2 text-secondary"></i>@item.NombreCompleto</td>
                                <td>@item.Email</td>
                                <td><span class="type-badge">@item.Rol</span></td>
                                <td style="text-align: right;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-link"><i class="bi bi-person-vcard"></i> Perfil</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-link"><i class="bi bi-pencil-square"></i> Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="action-link action-link-danger"><i class="bi bi-slash-circle"></i> Suspender</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" style="text-align: center; padding: 3rem; color: #6b7280;">No hay cuentas registradas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>