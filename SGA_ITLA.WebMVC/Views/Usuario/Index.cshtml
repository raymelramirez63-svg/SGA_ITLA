@model IEnumerable<SGA_ITLA.Domain.Entities.Usuarios.Usuario>
@{
    ViewData["Title"] = "Directorio de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="text-primary m-0 fw-bold">Directorio Institucional (Usuarios y Roles)</h3>
        <a asp-action="Create" class="btn btn-primary px-4 fw-bold">+ Registrar Cuenta</a>
    </div>

    <table class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre Completo</th>
                <th>Correo Institucional</th>
                <th>Rol Asignado</th>
                <th class="text-end pe-3">Gestión</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.Id</td>
                        <td class="fw-semibold">@item.NombreCompleto</td>
                        <td>@item.Email</td> 
                        <td>
                            <span class="badge bg-secondary fs-6">@item.Rol</span>
                        </td>
                        <td class="text-end pe-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Perfil</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Suspender</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center py-4 text-muted">No hay cuentas registradas.</td></tr>
            }
        </tbody>
    </table>
</div>