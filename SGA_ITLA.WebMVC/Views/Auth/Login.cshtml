@model SGA_ITLA.WebMVC.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="text-primary fw-bold">SGA Transporte</h2>
                    <p class="text-muted">Ingresa tus credenciales para continuar</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Correo" class="control-label fw-bold mb-1"></label>
                        <input asp-for="Correo" class="form-control form-control-lg" placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Clave" class="control-label fw-bold mb-1"></label>
                        <input asp-for="Clave" class="form-control form-control-lg" placeholder="********" />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Iniciar Sesión</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}