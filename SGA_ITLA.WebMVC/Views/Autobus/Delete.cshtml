@model SGA_ITLA.Domain.Entities.Transporte.Autobus
@{
    ViewData["Title"] = "Eliminar Autobús";
}

<div class="container mt-4">
    <h3 class="text-danger">¿Estás seguro que deseas desactivar esta unidad?</h3>
    <hr />
    <div class="card border-danger shadow-sm p-4" style="max-width: 500px;">
        <h5 class="fw-bold">Placa: @Model.Placa</h5>
        <p>Capacidad: @Model.CapacidadMaxima pasajeros</p>
        <p class="text-muted small">Esta acción ejecutará una baja lógica. El registro no desaparecerá de auditorías pasadas.</p>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger w-100">Confirmar Eliminación</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
        </form>
    </div>
</div>