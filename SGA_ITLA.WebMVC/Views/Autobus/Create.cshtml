@model SGA_ITLA.WebMVC.Models.AutobusViewModel

@{
    ViewData["Title"] = "Registrar Autobús";
}

<div class="card shadow-sm border-0 mt-4">
    <div class="card-body p-4">
        <h4 class="card-title text-primary mb-3">Registrar Nuevo Autobús</h4>
        <hr />
        
        <div class="row">
            <div class="col-md-6"> 
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Placa" class="control-label fw-bold"></label>
                        <input asp-for="Placa" class="form-control" placeholder="Ej: ITLA-001" />
                        <span asp-validation-for="Placa" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="CapacidadMaxima" class="control-label fw-bold"></label>
                        <input asp-for="CapacidadMaxima" class="form-control" type="number" />
                        <span asp-validation-for="CapacidadMaxima" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="EstadoOperativo" class="control-label fw-bold"></label>
                        <input asp-for="EstadoOperativo" class="form-control" type="number" placeholder="1 = Activo, 2 = Fuera de Servicio" />
                        <span asp-validation-for="EstadoOperativo" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Guardar Autobús" class="btn btn-primary px-4" />
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al Listado</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}