@model IEnumerable<SGA_ITLA.Domain.Entities.Transporte.Autobus>
@{
    ViewData["Title"] = "Catálogo de Autobuses";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Catálogo de Flota</h3>

        <!-- REGLA DEL AUDIO: SOLO EL ADMIN VE EL BOTON DE CREAR -->
        @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary">+ Registrar Autobús</a>
        }
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Placa</th>
                <th>Capacidad Máxima</th>
                <th>Estado Operativo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Placa</td>
                    <td>@item.CapacidadMaxima pasajeros</td>
                    <td>@item.EstadoOperativo</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>

                        @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>