@model IEnumerable<SGA_ITLA.WebMVC.Models.AutobusViewModel>

@{
    ViewData["Title"] = "Catálogo de Autobuses";
}

<h1>Catálogo de Autobuses</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="table-responsive shadow-sm rounded p-3 bg-white">

    <table class="table table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Placa)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CapacidadMaxima)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EstadoOperativo)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Placa)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CapacidadMaxima)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EstadoOperativo)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
