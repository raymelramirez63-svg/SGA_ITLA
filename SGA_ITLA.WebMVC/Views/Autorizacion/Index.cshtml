@model IEnumerable<SGA_ITLA.Domain.Entities.Autorizaciones.Autorizacion>
@{
    ViewData["Title"] = "Gestión de Autorizaciones";
}

<style>
    /* Estilos Empresariales Aislados (Garantiza que no se rompa) */
    .enterprise-wrap {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 2rem;
        margin-top: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .corp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e5e7eb;
    }

    .corp-title {
        color: #111827;
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.025em;
    }

    .corp-subtitle {
        color: #6b7280;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        margin-bottom: 0;
    }

    /* Botones Corporativos */
    .btn-primary-corp {
        background-color: #2563eb;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 0.6rem 1.2rem;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 0.2s;
        display: inline-block;
    }

        .btn-primary-corp:hover {
            background-color: #1d4ed8;
            color: #ffffff;
        }

    .btn-secondary-corp {
        background-color: #ffffff;
        color: #374151;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 0.6rem 1.2rem;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-block;
    }

        .btn-secondary-corp:hover {
            background-color: #f3f4f6;
            color: #111827;
        }

    /* Tabla de Datos */
    .table-container {
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .corp-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        margin: 0;
    }

        .corp-table th {
            background-color: #f9fafb;
            padding: 1rem 1.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            border-bottom: 1px solid #e5e7eb;
            letter-spacing: 0.05em;
        }

        .corp-table td {
            padding: 1rem 1.5rem;
            font-size: 0.875rem;
            color: #111827;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
        }

        .corp-table tbody tr:last-child td {
            border-bottom: none;
        }

        .corp-table tbody tr:hover {
            background-color: #f8fafc;
        }

    /* Badges Modernos */
    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 9999px;
    }

    .status-active {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-suspended {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .type-badge {
        background-color: #e0f2fe;
        color: #075985;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    /* Enlaces de Acción */
    .action-link {
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
        margin-right: 0.75rem;
        font-size: 0.875rem;
        transition: color 0.2s;
    }

        .action-link:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

    .action-link-danger {
        color: #dc2626;
        margin-right: 0;
    }

        .action-link-danger:hover {
            color: #b91c1c;
        }
</style>

<div class="container">
    <div class="enterprise-wrap">
        <div class="corp-header">
            <div>
                <h3 class="corp-title">Pases y Autorizaciones</h3>
                <p class="corp-subtitle">Gestión centralizada del catálogo de estudiantes</p>
            </div>
            <div>
                @*  REGLA DE NEGOCIO: Solo los administradores pueden emitir o recargar *@
                @if (User.IsInRole("AdminAutorizaciones") || User.IsInRole("Administrador"))
                {
                    <a asp-action="Recargar" class="btn-secondary-corp me-2">
                        <i class="bi bi-credit-card-fill text-warning me-1"></i> Recargar Tarjeta
                    </a>
                    <a asp-action="Create" class="btn-primary-corp">
                        <i class="bi bi-ticket-detailed-fill me-1"></i> Emitir Ticket Mensual
                    </a>
                }
            </div>
        </div>

        <div class="table-container">
            <table class="corp-table">
                <thead>
                    <tr>
                        <th>Usuario ID</th>
                        <th>Tipo</th>
                        <th>Vigencia / Saldo</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-weight: 600; color: #1f2937;">
                                    <i class="bi bi-person-badge text-secondary me-2 fs-5 align-middle"></i>Usuario #@item.UsuarioId
                                </td>
                                <td>
                                    <span class="type-badge">
                                        <i class="bi @(item.Tipo == SGA_ITLA.Domain.Enums.TipoAutorizacion.TicketMensual ? "bi-calendar-event" : "bi-wallet2") me-1"></i>@item.Tipo
                                    </span>
                                </td>
                                <td>
                                    @if (item.Tipo == SGA_ITLA.Domain.Enums.TipoAutorizacion.TicketMensual)
                                    {
                                        <span style="color: #6b7280; font-size: 0.85rem; margin-right: 4px;">Hasta:</span>
                                        <span style="font-weight: 500;">@(item.FechaFinVigencia?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                    }
                                    else
                                    {
                                        <span style="font-weight: 600; color: #059669;">
                                            <i class="bi bi-currency-dollar"></i>@item.SaldoDisponible
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="status-badge @(item.IsActive ? "status-active" : "status-suspended")">
                                        <i class="bi @(item.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                        @(item.IsActive ? "Activa" : "Suspendida")
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-link">
                                        <i class="bi bi-eye"></i> Detalles
                                    </a>

                                    @*  REGLA DE NEGOCIO: Auditor solo puede ver detalles, no puede editar ni borrar *@
                                    @if (User.IsInRole("AdminAutorizaciones") || User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-link">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-link action-link-danger ms-2">
                                            <i class="bi bi-trash3-fill fs-6"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 4rem; color: #6b7280;">
                                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                                No hay autorizaciones emitidas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>