@model IEnumerable<SGA_ITLA.Domain.Entities.Autorizaciones.Autorizacion>
@{
    ViewData["Title"] = "Gestión de Autorizaciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="text-success m-0 fw-bold">Pases y Autorizaciones</h3>
        <a asp-action="Create" class="btn btn-success px-4 text-white fw-bold">+ Emitir Ticket Mensual</a>
    </div>

    <table class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
        <thead class="table-dark">
            <tr>
                <th>Usuario ID</th>
                <th>Tipo</th>
                <th>Vigencia / Saldo</th>
                <th>Estado</th>
                <th class="text-end pe-3">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">Usuario #@item.UsuarioId</td>
                        <td><span class="badge bg-info text-dark">@item.Tipo</span></td>
                        <td>
                            @if (item.Tipo == SGA_ITLA.Domain.Enums.TipoAutorizacion.TicketMensual)
                            {
                                <span>Hasta: @(item.FechaFinVigencia?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                            }
                            else
                            {
                                <span class="fw-bold text-success">RD$ @item.SaldoDisponible</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                @(item.IsActive ? "Activa" : "Suspendida")
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">X</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center py-4 text-muted">No hay autorizaciones emitidas.</td></tr>
            }
        </tbody>
    </table>
</div>