@model SGA_ITLA.Application.Dtos.Autorizaciones.EmitirTicketDto
@{
    ViewData["Title"] = "Emitir Ticket";
}

<div class="container mt-5">
    <h3 class="text-success fw-bold">Emitir Nuevo Ticket Mensual</h3>
    <hr />
    <div class="card shadow-sm p-4 border-0" style="max-width: 500px;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UsuarioId" class="form-label fw-bold">Beneficiario (Estudiante/Empleado)</label>
                <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.Usuarios">
                    <option value="">-- Seleccionar Usuario --</option>
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PagoId" class="form-label fw-bold">ID del Recibo de Pago</label>
                <input asp-for="PagoId" type="number" class="form-control" placeholder="Ej: 10452" />
                <span asp-validation-for="PagoId" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="FechaInicio" class="form-label fw-bold">Fecha de Inicio de Vigencia</label>
                <input asp-for="FechaInicio" type="date" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold">Procesar Emisión</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
        </form>
    </div>
</div>