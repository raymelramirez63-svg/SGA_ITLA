@model SGA_ITLA.Application.Dtos.Catalogo.CreateRutaDto
@{
    ViewData["Title"] = "Registrar Ruta";
}

<div class="container mt-5">
    <h3 class="text-primary fw-bold">Registrar Nueva Ruta</h3>
    <hr />
    <div class="card shadow-sm p-4 border-0" style="max-width: 500px;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="NombreRuta" class="form-label fw-bold">Nombre Identificador de la Ruta</label>
                <input asp-for="NombreRuta" class="form-control" placeholder="Ej: Ruta Charles de Gaulle" />
                <span asp-validation-for="NombreRuta" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold">Guardar Ruta</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
        </form>
    </div>
</div>