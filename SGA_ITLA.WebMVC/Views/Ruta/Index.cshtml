@model IEnumerable<SGA_ITLA.Domain.Entities.Transporte.Ruta>
@{
    ViewData["Title"] = "Catálogo de Rutas";
}
<div class="container">
    <div class="enterprise-wrap">
        <div class="corp-header">
            <div>
                <h3 class="corp-title">Catálogo de Rutas</h3>
                <p class="corp-subtitle">Gestión de trayectos del transporte</p>
            </div>
            <div>
                @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                {
                    <a asp-action="Create" class="btn-primary-corp"><i class="bi bi-signpost-split-fill me-1"></i> Registrar Nueva Ruta</a>
                }
            </div>
        </div>
        <div class="table-container">
            <table class="corp-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre de la Ruta</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-weight: 600; color: #6b7280;">#@item.Id</td>
                                <td style="font-weight: 600; color: #1f2937;"><i class="bi bi-geo-alt-fill text-danger me-2"></i>@item.NombreRuta</td>
                                <td style="text-align: right;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-link"><i class="bi bi-eye"></i> Detalles</a>

                                    @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-link"><i class="bi bi-pencil-square"></i> Editar</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-link action-link-danger"><i class="bi bi-x-circle"></i> Desactivar</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" style="text-align: center; padding: 3rem; color: #6b7280;">No hay rutas registradas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>