@model IEnumerable<SGA_ITLA.Domain.Entities.Transporte.Ruta>
@{
    ViewData["Title"] = "Catálogo de Rutas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="text-primary m-0 fw-bold">Catálogo de Rutas</h3>

        @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary px-4">+ Registrar Nueva Ruta</a>
        }
    </div>

    <table class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
        <thead class="table-dark">
            <tr>
                <th class="ps-3">ID</th>
                <th>Nombre de la Ruta</th>
                <th class="text-end pe-3">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold">@item.Id</td>
                        <td class="fw-semibold">@item.NombreRuta</td>
                        <td class="text-end pe-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>

                            @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Desactivar</a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="3" class="text-center py-4 text-muted">No hay rutas registradas.</td></tr>
            }
        </tbody>
    </table>
</div>