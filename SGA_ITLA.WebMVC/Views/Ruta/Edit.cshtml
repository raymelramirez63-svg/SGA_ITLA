@model SGA_ITLA.Domain.Entities.Transporte.Ruta
@{
    ViewData["Title"] = "Editar Ruta";
}

<div class="container mt-5">
    <h3 class="text-warning fw-bold">Editar Ruta</h3>
    <hr />
    <div class="card shadow-sm p-4 border-0" style="max-width: 500px;">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label asp-for="NombreRuta" class="form-label fw-bold">Nombre de la Ruta</label>
                <input asp-for="NombreRuta" class="form-control" />
                <span asp-validation-for="NombreRuta" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning w-100 fw-bold">Guardar Cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
        </form>
    </div>
</div>