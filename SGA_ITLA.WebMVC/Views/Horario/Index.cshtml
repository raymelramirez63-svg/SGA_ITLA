@model IEnumerable<SGA_ITLA.Domain.Entities.Transporte.Horario>
@{
    ViewData["Title"] = "Gestión de Horarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="text-primary m-0 fw-bold">Horarios de Operación</h3>

        @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary px-4">+ Registrar Nuevo Horario</a>
        }
    </div>

    <table class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
        <thead class="table-dark">
            <tr>
                <th class="ps-3">ID Ruta</th>
                <th>Días de Operación</th>
                <th>Hora de Salida</th>
                <th class="text-end pe-3">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold text-primary">Ruta #@item.RutaId</td>
                        <td class="fw-semibold">@item.DiasOperacion</td>
                        <td><span class="badge bg-secondary fs-6">@item.HoraSalida.ToString(@"hh\:mm")</span></td>
                        <td class="text-end pe-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>

                            @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Desactivar</a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center py-4 text-muted">Aún no se han configurado horarios.</td></tr>
            }
        </tbody>
    </table>
</div>