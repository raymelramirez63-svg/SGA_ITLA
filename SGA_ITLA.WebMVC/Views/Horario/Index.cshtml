@model IEnumerable<SGA_ITLA.Domain.Entities.Transporte.Horario>
@{
    ViewData["Title"] = "Gestión de Horarios";
}
<div class="container">
    <div class="enterprise-wrap">
        <div class="corp-header">
            <div>
                <h3 class="corp-title">Horarios de Operación</h3>
                <p class="corp-subtitle">Planificación de salidas por ruta</p>
            </div>
            <div>
                @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                {
                    <a asp-action="Create" class="btn-primary-corp"><i class="bi bi-clock-fill me-1"></i> Registrar Nuevo Horario</a>
                }
            </div>
        </div>
        <div class="table-container">
            <table class="corp-table">
                <thead>
                    <tr>
                        <th>ID Ruta</th>
                        <th>Días de Operación</th>
                        <th>Hora de Salida</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-weight: 600; color: #2563eb;">Ruta #@item.RutaId</td>
                                <td style="font-weight: 500; color: #374151;">@item.DiasOperacion</td>
                                <td><span class="type-badge bg-dark text-white"><i class="bi bi-clock me-1"></i>@item.HoraSalida.ToString(@"hh\:mm")</span></td>
                                <td style="text-align: right;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-link"><i class="bi bi-eye"></i> Detalles</a>

                                    @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-link"><i class="bi bi-pencil-square"></i> Editar</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-link action-link-danger"><i class="bi bi-x-circle"></i> Desactivar</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" style="text-align: center; padding: 3rem; color: #6b7280;">Aún no se han configurado horarios.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>