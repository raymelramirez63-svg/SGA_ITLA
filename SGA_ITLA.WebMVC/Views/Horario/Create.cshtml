@model SGA_ITLA.Application.Dtos.Catalogo.CreateHorarioDto
@{
    ViewData["Title"] = "Registrar Horario";
}

<div class="container mt-5">
    <h3 class="text-primary fw-bold">Configurar Nuevo Horario</h3>
    <hr />
    <div class="card shadow-sm p-4 border-0" style="max-width: 550px;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="RutaId" class="form-label fw-bold">Seleccione la Ruta</label>
                <select asp-for="RutaId" class="form-select" asp-items="ViewBag.Rutas" required>
                    <option value="">-- Seleccione una Ruta --</option>
                </select>
                <span asp-validation-for="RutaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DiasOperacion" class="form-label fw-bold">Días de Operación</label>
                <input asp-for="DiasOperacion" class="form-control" placeholder="Ej: Lunes a Viernes" required />
                <span asp-validation-for="DiasOperacion" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="HoraSalida" class="form-label fw-bold">Hora Exacta de Salida</label>
                <input asp-for="HoraSalida" type="time" class="form-control" required />
                <span asp-validation-for="HoraSalida" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold">Guardar Horario</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
        </form>
    </div>
</div>