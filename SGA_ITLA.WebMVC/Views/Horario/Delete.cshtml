@model SGA_ITLA.Domain.Entities.Transporte.Horario
@{
    ViewData["Title"] = "Eliminar Horario";
}

<div class="container mt-5">
    <h3 class="text-danger fw-bold">Confirmar Eliminación</h3>
    <hr />
    <div class="card shadow-sm p-4 border-danger" style="max-width: 500px;">
        <h5 class="text-center mb-3">¿Desactivar esta ventana de horario?</h5>

        <div class="bg-light p-3 rounded mb-4 text-center">
            <h4 class="text-primary m-0">@Model.HoraSalida.ToString(@"hh\:mm")</h4>
            <small class="text-muted">Ruta #@Model.RutaId | @Model.DiasOperacion</small>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger w-100 fw-bold">Sí, Desactivar</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
        </form>
    </div>
</div>