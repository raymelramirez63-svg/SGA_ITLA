<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SGA ITLA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!--  Iconos de Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!--  Estilos Empresariales Globales -->
    <style>
            .enterprise-wrap {
                font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                background-color: #f8f9fa;
                border-radius: 8px;
                padding: 2rem;
                margin-top: 1.5rem;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            }

            .corp-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 2rem;
                padding-bottom: 1rem;
                border-bottom: 2px solid #e5e7eb;
            }

            .corp-title {
                color: #111827;
                font-size: 1.5rem;
                font-weight: 700;
                margin: 0;
                letter-spacing: -0.025em;
            }

            .corp-subtitle {
                color: #6b7280;
                font-size: 0.875rem;
                margin-top: 0.25rem;
                margin-bottom: 0;
            }

            .btn-primary-corp {
                background-color: #2563eb;
                color: #ffffff;
                border: none;
                border-radius: 6px;
                padding: 0.6rem 1.2rem;
                font-size: 0.875rem;
                font-weight: 500;
                text-decoration: none;
                transition: background-color 0.2s;
                display: inline-block;
            }

                .btn-primary-corp:hover {
                    background-color: #1d4ed8;
                    color: #ffffff;
                }

            .btn-secondary-corp {
                background-color: #ffffff;
                color: #374151;
                border: 1px solid #d1d5db;
                border-radius: 6px;
                padding: 0.6rem 1.2rem;
                font-size: 0.875rem;
                font-weight: 500;
                text-decoration: none;
                transition: all 0.2s;
                display: inline-block;
            }

                .btn-secondary-corp:hover {
                    background-color: #f3f4f6;
                    color: #111827;
                }

            .table-container {
                background-color: #ffffff;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                overflow: hidden;
            }

            .corp-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                margin: 0;
            }

                .corp-table th {
                    background-color: #f9fafb;
                    padding: 1rem 1.5rem;
                    font-size: 0.75rem;
                    font-weight: 600;
                    color: #6b7280;
                    text-transform: uppercase;
                    border-bottom: 1px solid #e5e7eb;
                    letter-spacing: 0.05em;
                }

                .corp-table td {
                    padding: 1rem 1.5rem;
                    font-size: 0.875rem;
                    color: #111827;
                    border-bottom: 1px solid #e5e7eb;
                    vertical-align: middle;
                }

                .corp-table tbody tr:last-child td {
                    border-bottom: none;
                }

                .corp-table tbody tr:hover {
                    background-color: #f8fafc;
                }

            .status-badge {
                display: inline-flex;
                align-items: center;
                padding: 0.25rem 0.75rem;
                font-size: 0.75rem;
                font-weight: 600;
                border-radius: 9999px;
            }

            .status-active {
                background-color: #dcfce7;
                color: #166534;
            }

            .status-suspended {
                background-color: #fee2e2;
                color: #991b1b;
            }

            .type-badge {
                background-color: #e0f2fe;
                color: #075985;
                padding: 0.25rem 0.75rem;
                border-radius: 9999px;
                font-size: 0.75rem;
                font-weight: 600;
            }

            .action-link {
                color: #2563eb;
                text-decoration: none;
                font-weight: 500;
                margin-right: 0.75rem;
                font-size: 0.875rem;
                transition: color 0.2s;
            }

                .action-link:hover {
                    color: #1d4ed8;
                    text-decoration: underline;
                }

            .action-link-danger {
                color: #dc2626;
                margin-right: 0;
            }

                .action-link-danger:hover {
                    color: #b91c1c;
                }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow mb-4 py-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold fs-4 text-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bus-front-fill me-1"></i> SGA-ITLA
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1 ms-4">
                        <li class="nav-item me-2">
                            <a class="nav-link fs-6" asp-controller="Autobus" asp-action="Index">Catálogo de Autobuses</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link fs-6" asp-controller="Ruta" asp-action="Index">Rutas</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link fs-6" asp-controller="Viaje" asp-action="Index">Viajes</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link fs-6" asp-controller="Horario" asp-action="Index">Horarios</a>
                        </li>

                        @* REGLA ESTRICTA: Solo Finanzas/Auditoría ven Autorizaciones *@
                        @if (User.IsInRole("AdminAutorizaciones") || User.IsInRole("Administrador") || User.IsInRole("Auditor"))
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link fs-6 text-warning fw-bold" asp-controller="Autorizacion" asp-action="Index">💳 Autorizaciones</a>
                            </li>
                        }

                        @* REGLA ESTRICTA: Solo Transporte y SuperAdmin ven Usuarios *@
                        @if (User.IsInRole("AdminTransporte") || User.IsInRole("Administrador"))
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link fs-6 text-info fw-bold" asp-controller="Usuario" asp-action="Index">👥 Usuarios</a>
                            </li>
                        }

                        @if (User.IsInRole("AdminTransporte") || User.IsInRole("Auditor") || User.IsInRole("Administrador"))
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link fs-6 text-white opacity-75 fw-bold" asp-controller="Auditoria" asp-action="Index">📋 Auditoría</a>
                            </li>
                        }

                        @if (User.IsInRole("Estudiante"))
                        {
                            <li class="nav-item me-2"><a class="nav-link fs-6 text-success fw-bold" asp-controller="Solicitud" asp-action="Index">🎫 Mis Solicitudes</a></li>
                        }

                        @if (User.IsInRole("AdminAutorizaciones") || User.IsInRole("Administrador"))
                        {
                            <li class="nav-item me-2"><a class="nav-link fs-6 text-success fw-bold" asp-controller="Solicitud" asp-action="Pendientes">🎫 Solicitudes Pendientes</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            var userName = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name;
                            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario";

                            <li class="nav-item me-4 d-flex align-items-center">
                                <div class="text-end me-2 text-white">
                                    <div class="fw-bold lh-1" style="font-size: 0.9rem;">@userName</div>
                                    <span class="badge bg-secondary bg-opacity-50 mt-1" style="font-size: 0.7rem; font-weight: 500; letter-spacing: 0.5px;">
                                        <i class="bi bi-shield-lock-fill me-1"></i>@role
                                    </span>
                                </div>
                                <div class="bg-primary rounded-circle d-flex justify-content-center align-items-center shadow-sm border border-light border-opacity-25" style="width: 38px; height: 38px;">
                                    <i class="bi bi-person-fill fs-5 text-white"></i>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-danger btn-sm px-4 rounded-pill fw-bold d-flex align-items-center" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-3">
        <div class="container text-center fw-semibold">
            &copy; 2026 - Sistema de Gestión de Autobuses ITLA (SGA)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>