@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error del Sistema.</h1>
<h2 class="text-danger">Ha ocurrido un error interno mientras se procesaba tu solicitud.</h2>

@if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
{
    <h3>Modo de Desarrollo Activo</h3>
    <p>
        Verifica la consola de Visual Studio o los logs de la aplicación para obtener información detallada sobre la excepción y la traza del error.
    </p>
}
else
{
    <p>
        Por favor, contacte al Administrador de Transporte si el problema persiste.
    </p>
}